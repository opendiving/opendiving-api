# The front door for a bundled-Caddy install. Read by the `caddy` service in
# docker-compose.yml, which is what publishes 80/443; nothing else in the bundle is
# reachable from outside the compose network.
#
# One variable reaches it from `.env`, through compose: CADDY_SITE_ADDRESS, the address
# to answer on. It defaults to DOMAIN, which is what makes the certificate automatic; set
# it to `:80` for a LAN instance with no domain, since Caddy cannot get a certificate for
# an IP address.
#
# Certificates are issued to an ACME account with no contact address, which is valid and
# costs only the expiry warnings nobody needs while renewal is automatic. Want them? Add a
# global block above the site with `email you@example.com` in it - it takes a real
# address, so there is no way to offer it as an environment variable that may be empty.
#
# Running your own proxy instead? None of this applies - point it at `web:3000` and read
# docs/self-hosting/reverse-proxy.md, which covers the two things that are easy to get
# wrong (TRUSTED_PROXY_IPS, and the admin panel's path).

{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	# Everything the API serves at the edge, straight to it - the web container is a
	# perfectly good proxy for `/api/v1` and there is no reason to add a Node hop to a 10
	# MB card upload or a whole-logbook export archive.
	#
	# The three docs paths and `/admin` are here because they mount on the *API*, not on
	# the web app: a plain "everything to web:3000" file leaves an enabled admin panel and
	# the OpenAPI docs answering 404 with nothing to suggest why. `/docs` and friends are
	# absent on ENVIRONMENT=production anyway - routing them costs nothing and means that
	# a staging instance behaves the way its operator expects.
	#
	# No body-size limit is set: Caddy imposes none by default, and the app enforces its
	# own (5 MB dive files, 10 MB card images) with an error message that explains itself.
	@api path /api/v1* /admin* /docs /redoc /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	# The web app, which also carries `/healthz` and the Next.js static assets. It sets
	# its own security headers, HSTS included (`WEB_HSTS=off` turns that one off), so
	# there is nothing to add here.
	handle {
		reverse_proxy web:3000
	}
}
