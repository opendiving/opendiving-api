# OpenDiving API configuration.
#
#   cp src/.env.example src/.env
#
# Then change SECRET_KEY, POSTGRES_PASSWORD and ADMIN_PASSWORD at minimum. Everything
# uncommented below is enough to bring the stack up with `docker compose up`; the
# commented-out settings show their built-in defaults and only need touching if you
# want something else. `src/app/core/config.py` is the full, authoritative list.
#
# Note that docker compose feeds this same file to the `db` container, which is why the
# POSTGRES_* values below are both the app's connection settings and the credentials
# Postgres initializes itself with.

# -------- Application (OpenAPI metadata shown at /docs) --------
APP_NAME="OpenDiving"
APP_DESCRIPTION="Backend API for OpenDiving."
APP_VERSION="0.1.0"
# LICENSE="AGPL-3.0"
# Who maintains this API. Metadata only - this is NOT where the contact form delivers
# to; that's CONTACT_FORM_EMAIL near the bottom.
# CONTACT_NAME="Your Name"
# CONTACT_EMAIL="you@example.com"

# -------- Database --------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
# "db" is the compose service name. Use "localhost" when running the API outside docker.
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_DB="opendive"

# -------- Security --------
# Signs access/refresh/onboarding tokens. Generate your own - never reuse this or any
# published value, and rotating it signs every existing session out:
#   openssl rand -hex 32
SECRET_KEY="change-me-openssl-rand-hex-32"
# ALGORITHM="HS256"
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# ONBOARDING_TOKEN_EXPIRE_MINUTES=30
# How long a parsed dive-computer file stays attachable to a dive. Long on purpose - a
# diver may import a file, then spend an evening filling in sites and gear before saving.
# DIVE_FILE_TOKEN_EXPIRE_MINUTES=1440

# -------- Redis (cache + arq queue) --------
REDIS_CACHE_HOST="redis"
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST="redis"
REDIS_QUEUE_PORT=6379
# CLIENT_CACHE_MAX_AGE=60

# -------- First superuser --------
# Created by `python -m src.scripts.create_first_superuser`, and the login for the
# CRUDAdmin interface at /admin.
# ADMIN_PASSWORD has no default. Leave it unset and no admin account is created at all;
# set it and you get one with full create/update/delete over every model. On
# ENVIRONMENT="production" with CRUD_ADMIN_ENABLED=true, startup fails unless this is a
# real password.
ADMIN_NAME="Your Name"
ADMIN_EMAIL="you@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# -------- Environment --------
# local | staging | production. Controls the interactive docs: open at /docs on "local",
# superuser-only on "staging", entirely absent on "production".
ENVIRONMENT="local"

# -------- Frontend --------
# Used to build the links in outgoing email ({FRONTEND_URL}/auth/verify?token=...) and,
# just as importantly, as the single allowed CORS origin - a browser that can load the
# web app but gets CORS errors from the API is almost always this being wrong.
FRONTEND_URL="http://localhost:3000"

# -------- Email (https://resend.com) --------
# Leave RESEND_API_KEY unset for local development: nothing is sent, and the magic-link
# URL is written to the API logs instead, which is the intended local sign-in flow.
# RESEND_API_KEY="re_..."
# Must be an address on a domain you've verified with Resend.
EMAIL_FROM_ADDRESS="onboarding@resend.dev"

# -------- Contact form (POST /api/v1/contact) --------
# Where the web app's contact form delivers to. Point this at your own inbox when
# self-hosting - the default reaches the upstream project, which can't see your server
# or help your users. Delivery still needs RESEND_API_KEY above.
CONTACT_FORM_EMAIL="contact@opendiving.app"
# Fixed-window rate limits on that endpoint, keyed by submitted email and by client IP.
# It's unauthenticated and sends mail, so these are what keep it from being used as a relay.
# CONTACT_FORM_RATE_LIMIT_WINDOW_SECONDS=3600
# CONTACT_FORM_RATE_LIMIT_PER_EMAIL=3
# CONTACT_FORM_RATE_LIMIT_PER_IP=10

# -------- Google Sign-In (optional) --------
# OAuth 2.0 client ID from the Google Cloud Console, "Web application" type. Not a
# secret. Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave unset to hide
# the "Continue with Google" button.
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# -------- Magic-link sign-in --------
# MAGIC_LINK_TOKEN_EXPIRE_MINUTES=30
# MAGIC_LINK_RATE_LIMIT_WINDOW_SECONDS=900
# MAGIC_LINK_REQUEST_RATE_LIMIT_PER_EMAIL=3
# MAGIC_LINK_REQUEST_RATE_LIMIT_PER_IP=15
# MAGIC_LINK_VERIFY_RATE_LIMIT_PER_IP=30
# EMAIL_CHANGE_TOKEN_EXPIRE_MINUTES=30
# EMAIL_CHANGE_REQUEST_RATE_LIMIT_PER_USER=3

# -------- Gear service reminders --------
# Hour of day (UTC) the "your gear is due for service" digest cron runs.
# GEAR_SERVICE_DIGEST_HOUR=7

# -------- Admin interface (CRUDAdmin, mounted at /admin) --------
# Off unless you turn it on. The panel talks to the models directly, bypassing every
# ownership check in api/v1, so it is opt-in rather than something a deploy inherits.
# In production it additionally requires a real ADMIN_PASSWORD and, ideally, an IP
# allowlist below.
CRUD_ADMIN_ENABLED=true
# CRUD_ADMIN_MOUNT_PATH="/admin"
# CRUD_ADMIN_MAX_SESSIONS=10
# CRUD_ADMIN_SESSION_TIMEOUT=1440
# Session cookies are Secure by default, so they will not survive plain HTTP. Set this
# to false only for local development over http://localhost.
# SESSION_SECURE_COOKIES=true
# CRUD_ADMIN_TRACK_EVENTS=true
# CRUD_ADMIN_TRACK_SESSIONS=true
# CRUD_ADMIN_REDIS_ENABLED=false
# CRUD_ADMIN_REDIS_HOST="localhost"
# CRUD_ADMIN_REDIS_PORT=6379
# CRUD_ADMIN_REDIS_DB=0
# CRUD_ADMIN_REDIS_PASSWORD=""
# CRUD_ADMIN_REDIS_SSL=false
