{
  // What tells anyone a dependency has moved. The other half of the same story is
  // `.github/workflows/vulnerability-scan.yml`, which watches the images that are *already
  // published* - a base image grows a CVE weeks after it shipped, with no PR in flight, and
  // no bot that reads this repository's files can see that. The two are not substitutes.
  //
  // **This file is configuration for a bot that has to be running somewhere, and one is.** The
  // Mend-hosted Renovate GitHub App is installed on the `opendiving` org; it reads this file on
  // its next run and reports through the **Dependency Dashboard** issue it opens and keeps
  // updated in this repository, which is where anything it is holding back shows up. The
  // installation names its repositories one at a time rather than covering the whole org, so a
  // repository added later has to be added to the installation before its own copy of this file
  // is read by anybody - until then its pins are frozen and nothing says so, which is the
  // failure this file exists to end. CONTRIBUTING.md, "Staying on top of CVEs", has the detail.
  //
  // Renovate rather than Dependabot, and not for the reason usually given. Dependabot has had
  // a `docker-compose` ecosystem since February 2025, so the development compose file's
  // third-party images are reachable to it after all. What it has no ecosystem for is **uv** -
  // and `uv.lock` is what the shipped image installs from (`uv sync --locked` in the Dockerfile),
  // so under Dependabot the entire Python dependency tree would go unwatched. It also cannot
  // read `.python-version`, and its groups are scoped to one ecosystem, which makes the
  // coordinated Python move below inexpressible. Any one of the three would be worth working
  // around; together they decide it.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",

    // Every routine Renovate PR is titled `chore(deps): ...`, which `pr-title.yml` accepts
    // and `.github/release.yml` files under "Other changes". `config:recommended` on its own
    // titles production-dependency updates `fix(deps):`, which would file every version bump
    // in the release notes' Fixes section beside real bug fixes. The deliberate exception is
    // `vulnerabilityAlerts` below: a vulnerability-driven update *is* a fix, and says so.
    ":semanticCommitTypeAll(chore)",
  ],

  // The surface the Python-runtime rule below reports to, so it is stated rather than
  // inherited: an update held back for a human is only "detection" if there is somewhere it
  // shows up.
  "dependencyDashboard": true,

  "labels": ["dependencies"],

  // Routine updates arrive in one weekly batch rather than whenever an upstream publishes.
  // Vulnerability-driven ones ignore this entirely - see `vulnerabilityAlerts`. Times are
  // UTC; no `timezone` is set because nothing here cares which morning it is.
  "schedule": ["before 9am on monday"],

  // Load-bearing, and the default only by luck. This repository pins in several styles on
  // purpose, and Renovate's job is to renew whichever it finds rather than to normalise:
  //
  //   - `Dockerfile` floats on `python:3.14-slim-bookworm` and the uv image because that one
  //     *is* built, and the float is what makes the CVE rebuild in CONTRIBUTING.md work at
  //     all: re-running Publish Image at an old `v` tag picks up the patched Debian packages
  //     precisely because the base is resolved at build time. Digest-pin it and that rebuild
  //     reproduces the vulnerable base byte for byte and fixes nothing.
  //   - The development `docker-compose.yml` pins `postgres` and `redis` on a bare major and
  //     `axllent/mailpit` on `v1.30`, which is the widest tag that image publishes - wide
  //     enough to pick up patches on a `pull`, narrow enough that two machines a year apart
  //     are not running different majors and unaware of it.
  //   - `.github/workflows/*` pins first-party actions on a major tag (`actions/checkout@v7`)
  //     and third-party ones by SHA with a trailing version comment. Renovate updates the
  //     SHA *and* the comment, and leaves the tags as tags.
  //
  // `pinDigests: true` - or the `helpers:pinGitHubActionDigests` preset - would flatten all
  // three into one style and break the first outright.
  //
  // The install bundle digest-pins its third-party images by hand, and lives in
  // https://github.com/opendiving/opendiving. Its config sets `pinDigests: false` too - but
  // for the opposite argument, and its own comment says so. Nothing there is *built* at all,
  // so there is no floating base to protect; the flag is false so that Renovate renews the
  // pins already written rather than normalising the style away. Same value, different
  // reason, and neither is the default worth inheriting by accident.
  "pinDigests": false,

  // The transitive half. `uv.lock` pins the whole resolved tree, and a CVE is at least as
  // likely to be three levels down as in something `pyproject.toml` names; nothing else here
  // ever refreshes those. Monthly, because it is a wide diff that wants reading.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"],
  },

  // The one thing that must not wait for Monday. `semanticCommitType: "fix"` puts these in
  // the Fixes section of the release notes, where someone deciding whether to upgrade reads.
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "semanticCommitType": "fix",
    "labels": ["dependencies", "security"],
  },

  // GitHub's own alerts have to be switched on in repository settings to reach Renovate.
  // OSV needs nothing switched on anywhere, so the alerting above works from the merge of
  // this file rather than from whenever someone remembers the settings page.
  "osvVulnerabilityAlerts": true,

  "packageRules": [
    {
      // A Python version is a coordinated change across four files, and only two of them are
      // reachable by any bot: `.python-version` (pyenv manager) and the two `Dockerfile`
      // base tags. The other two are `requires-python = "~=3.14.0"` and ruff's
      // `target-version = "py314"` in `pyproject.toml`, which Renovate does not update -
      // there is an open feature request for the first and nothing at all for the second.
      //
      // So an auto-opened PR here would be *wrong by construction*: it would move the
      // interpreter and leave `requires-python` behind, and `uv sync --locked` would refuse
      // to install into it. `dependencyDashboardApproval` is the honest handling - the
      // dashboard says "Python 3.15 is out", nobody gets a red PR, and the person who ticks
      // the box does the other two files by hand. Grouping them keeps it one checkbox
      // instead of three.
      "matchManagers": ["pyenv", "dockerfile"],
      "matchPackageNames": ["python", "ghcr.io/astral-sh/uv"],
      "groupName": "Python runtime",
      "dependencyDashboardApproval": true,
    },
  ],
}
